{
  "name": "claude-session-hq",
  "version": "0.1.0",
  "private": true,
  "description": "이 Mac의 Claude Code 세션을 한 화면에 모아 보고, 웹 안의 터미널로 직접 일하는 로컬 관제판",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p web",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@mantine/notifications": "9.7.2",
    "@tabler/icons-react": "3.49.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
